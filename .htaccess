# RAM – rent-apartment-milan.com – sito statico (ott 2026)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS e dominio senza www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://rent-apartment-milan.com/$1 [R=301,L]

# Vecchi URL WordPress: query string ?p= / ?page_id= / feed
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|attachment_id|cat|author)=[0-9]+ [NC]
RewriteRule ^$ /? [R=301,L]
RewriteRule ^(feed|comments/feed|wp-json|xmlrpc\.php|wp-login\.php|wp-admin|wp-includes)(/.*)?$ - [G,L]
RewriteRule ^wp-content/.*$ - [G,L]

# Pagine reali -> nuove pagine (301)
RewriteRule ^about-ram/?$ /about/ [R=301,L]
RewriteRule ^pages/our-staff/?$ /about/ [R=301,L]
RewriteRule ^accommodation/authentic-milanese-studio/?$ /apartments/studio-turro-martesana/ [R=301,L]
RewriteRule ^available-offer/?$ /apartments-milan-no-deposit/ [R=301,L]
RewriteRule ^accommodation/cozy-two-room-apartment/?$ /apartments/one-bedroom-val-di-non-balcony/ [R=301,L]
RewriteRule ^(accommodation|accommodation-category|apartments-available|availability-search)(/.*)?$ /apartments/ [R=301,L]
RewriteRule ^dsads/?$ /long-term-flat-rentals-in-milan/ [R=301,L]
RewriteRule ^pages/faq/?$ /faq/ [R=301,L]
RewriteRule ^pages/our-reviews/?$ /reviews/ [R=301,L]
RewriteRule ^pages/whats-nearby/?$ /precotto-turro-martesana-neighbourhood-guide/ [R=301,L]
RewriteRule ^home/contact-us/?$ /contact/ [R=301,L]
RewriteRule ^booking-confirmation/terms-conditions/?$ /privacy/ [R=301,L]
RewriteRule ^booking-confirmation(/.*)?$ /contact/ [R=301,L]
RewriteRule ^blog/blog-style[^/]*/?$ /blog/ [R=301,L]
RewriteRule ^category(/.*)?$ /blog/ [R=301,L]
RewriteRule ^(home|home-3|home-4|pages|pages/gallery|pages/offers)/?$ / [R=301,L]

# Contenuti demo del vecchio tema: rimossi definitivamente (410)
RewriteRule ^(tiny-homes|services|shop|my-account|sample-page|elementor-thhf|author|pages/covid-19)(/.*)?$ - [G,L]
</IfModule>

# Compressione
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Cache: immagini 1 anno, HTML 1 ora
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/html "access plus 1 hour"
ExpiresByType application/xml "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(webp|jpe?g|png)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
AddType image/webp .webp
AddDefaultCharset UTF-8

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
