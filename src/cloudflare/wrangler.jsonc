// Configurazione Cloudflare Workers per rent-apartment-milan.com.
// Questo file viene copiato nel branch "deploy": Cloudflare (Workers Builds) lo usa per pubblicare il sito a ogni push.
{
  "name": "rent-apartment-milan",
  "main": "_worker/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["vsemeraro@gmail.com"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "ram-events", "database_id": "7f2f4c20-ed20-4f3d-8604-46334a952f66" }],
  "routes": [
    { "pattern": "rent-apartment-milan.com/*", "zone_name": "rent-apartment-milan.com" },
    { "pattern": "www.rent-apartment-milan.com/*", "zone_name": "rent-apartment-milan.com" }
  ],
  "observability": { "enabled": true },
  "keep_vars": true
}
